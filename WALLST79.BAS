10 REM WALL STREET 1979 - FORTUNE 100 CORPORATE MONITOR
20 REM VINTAGE LINE-NUMBERED BASIC / QB64-PE BUILD
30 GOSUB 1000
40 GOSUB 1600
50 GOSUB 2000
60 END

1000 REM ===== INITIALIZATION =====
1010 _TITLE "WALL STREET 1979 - FORTUNE 100 CORPORATE MONITOR"
1020 SCREEN 0
1030 WIDTH 120, 40
1040 COLOR 10, 0
1050 RecordCount = 100
1060 PriceCount = 0
1070 McapCount = 0
1080 MaxProfit = 0
1085 DIM RK(100), CN$(100), RV(100), PF(100), HPF(100)
1086 DIM HN$(100), ALIAS$(100), HPX(100), PX(100), PD$(100), PK$(100)
1087 DIM HMC(100), MCAP(100), MD$(100), ORD(100), DirList(100), BoardList(100), SavedDirList(100)
1090 GOSUB 1200
1100 GOSUB 1450
1110 RETURN

1200 REM ===== LOAD EMBEDDED FORTUNE DATA =====
1210 FOR I = 1 TO RecordCount
1220 READ RK(I), CN$(I), RV(I), PFT$
1230 IF UCASE$(PFT$) = "N.A." OR UCASE$(PFT$) = "N/A" THEN HPF(I) = 0 ELSE HPF(I) = 1: PF(I) = VAL(PFT$)
1240 ORD(I) = I
1250 HN$(I) = ""
1260 ALIAS$(I) = ""
1270 HPX(I) = 0
1280 PX(I) = 0
1290 PD$(I) = ""
1300 PK$(I) = ""
1310 HMC(I) = 0
1320 MCAP(I) = 0
1330 MD$(I) = ""
1340 IF HPF(I) = 1 AND PF(I) > MaxProfit THEN MaxProfit = PF(I)
1350 NEXT I
1360 ALIAS$(1) = "GM"
1370 ALIAS$(2) = "XOM"
1380 ALIAS$(3) = "FORD"
1390 ALIAS$(7) = "IBM"
1400 ALIAS$(8) = "GE"
1410 ALIAS$(10) = "CHRYSLER"
1420 ALIAS$(50) = "MMM"
1430 RETURN

1450 REM ===== DATA INVARIANTS =====
1460 LoadStatus$ = "OK"
1470 IF RecordCount <> 100 THEN LoadStatus$ = "CHECK COUNT"
1480 IF RK(1) <> 1 OR CN$(1) <> "General Motors" THEN LoadStatus$ = "CHECK RANK 1"
1490 IF RK(7) <> 7 OR CN$(7) <> "Intl. Business Machines" THEN LoadStatus$ = "CHECK RANK 7"
1500 IF RK(91) <> 91 OR HPF(91) <> 0 THEN LoadStatus$ = "CHECK MISSING PROFIT"
1510 IF RK(100) <> 100 OR CN$(100) <> "PPG Industries" THEN LoadStatus$ = "CHECK RANK 100"
1520 RETURN

1600 REM ===== STARTUP SCREEN =====
1610 CLS
1620 COLOR 10, 0
1630 LOCATE 5, 18: PRINT "WALL STREET DATA SYSTEM"
1640 LOCATE 6, 18: PRINT "COPYRIGHT 1979 // HISTORICAL RECONSTRUCTION"
1650 LOCATE 8, 18: PRINT "MEMORY TEST ........ OK"
1660 LOCATE 9, 18: PRINT "FORTUNE TABLE ...... " + LTRIM$(STR$(RecordCount)) + " RECORDS"
1670 LOCATE 10, 18: PRINT "PRICE TABLE ........ " + LTRIM$(STR$(PriceCount)) + " VERIFIED / " + LTRIM$(STR$(RecordCount - PriceCount)) + " UNAVAILABLE"
1680 LOCATE 11, 18: PRINT "MCAP TABLE ......... " + LTRIM$(STR$(McapCount)) + " VERIFIED / " + LTRIM$(STR$(RecordCount - McapCount)) + " UNAVAILABLE"
1690 LOCATE 12, 18: PRINT "INDEX .............. READY"
1700 LOCATE 15, 18: COLOR 14, 0: PRINT "PRESS ANY KEY TO ENTER"
1710 COLOR 10, 0
1720 K$ = INKEY$
1730 IF K$ = "" THEN GOTO 1720
1740 RETURN

2000 REM ===== MAIN MENU =====
2010 GOSUB 9000
2020 LOCATE 5, 1: PRINT " [1] COMPANY DIRECTORY"
2030 LOCATE 6, 1: PRINT " [2] TOP 10 BOARD"
2040 LOCATE 7, 1: PRINT " [3] SEARCH"
2050 LOCATE 8, 1: PRINT " [4] SORT / RANKINGS"
2060 LOCATE 9, 1: PRINT " [5] COMPANY COMPARISON"
2070 LOCATE 10, 1: PRINT " [6] 1979 MARKET DATA NOTES"
2080 LOCATE 11, 1: PRINT " [7] ABOUT / SOURCES"
2090 LOCATE 12, 1: PRINT " [Q] QUIT"
2100 LOCATE 15, 1: PRINT "FORTUNE RANK = REVENUE RANK. MARKET CAP IS A SEPARATE CONCEPT."
2110 LOCATE 17, 1: PRINT "SELECT FUNCTION: ";
2120 K$ = INKEY$
2130 IF K$ = "" THEN GOTO 2120
2140 K$ = UCASE$(K$)
2150 IF K$ = "1" THEN GOSUB 3000: GOTO 2010
2160 IF K$ = "2" THEN GOSUB 8000: GOTO 2010
2170 IF K$ = "3" THEN GOSUB 5000: GOTO 2010
2180 IF K$ = "4" THEN GOSUB 6000: GOTO 2010
2190 IF K$ = "5" THEN GOSUB 7000: GOTO 2010
2200 IF K$ = "6" THEN GOSUB 15000: GOTO 2010
2210 IF K$ = "7" THEN GOSUB 15000: GOTO 2010
2220 IF K$ = "Q" OR K$ = CHR$(27) THEN RETURN
2230 GOTO 2120

3000 REM ===== DIRECTORY ENTRY =====
3010 DirCount = RecordCount
3020 FOR I = 1 TO RecordCount
3030 DirList(I) = ORD(I)
3040 NEXT I
3050 DirTitle$ = "COMPANY DIRECTORY"
3060 DirPos = 1
3070 GOSUB 3100
3080 RETURN

3100 REM ===== DIRECTORY SCREEN =====
3110 IF DirCount <= 0 THEN RETURN
3120 IF DirPos < 1 THEN DirPos = 1
3130 IF DirPos > DirCount THEN DirPos = DirCount
3140 GOSUB 9000
3150 LOCATE 4, 1: PRINT DirTitle$
3160 LOCATE 5, 1: PRINT "RK  COMPANY                         REVENUE       PROFIT       MARGIN"
3170 LOCATE 6, 1: PRINT "--- ------------------------------ ------------- ------------- --------"
3180 PageNo = INT((DirPos - 1) / 12) + 1
3190 PageTotal = INT((DirCount - 1) / 12) + 1
3200 LOCATE 4, 88: PRINT "PAGE " + LTRIM$(STR$(PageNo)) + "/" + LTRIM$(STR$(PageTotal))
3210 PageStart = (PageNo - 1) * 12 + 1
3220 PageEnd = PageStart + 11
3230 IF PageEnd > DirCount THEN PageEnd = DirCount
3240 Row = 7
3250 FOR J = PageStart TO PageEnd
3260 I = DirList(J)
3270 IF J = DirPos THEN COLOR 14, 0 ELSE COLOR 10, 0
3280 LOCATE Row, 1: IF J = DirPos THEN PRINT ">" ELSE PRINT " "
3290 RKText$ = RIGHT$("  " + LTRIM$(STR$(RK(I))), 2)
3300 LOCATE Row, 4: PRINT RKText$
3310 Source$ = UCASE$(CN$(I))
3320 MaxLen = 30
3330 GOSUB 9400
3340 LOCATE Row, 7: PRINT Trunc$
3350 FmtVal = RV(I)
3360 GOSUB 9300
3370 LOCATE Row, 39: PRINT Fmt$
3380 IF HPF(I) = 1 THEN FmtVal = PF(I): GOSUB 9300: ProfitText$ = Fmt$ ELSE ProfitText$ = "N/A"
3390 LOCATE Row, 53: PRINT ProfitText$
3400 IF HPF(I) = 1 THEN MarginVal = PF(I) / RV(I) * 100: GOSUB 9370: MarginText$ = Pct$ ELSE MarginText$ = "N/A"
3410 LOCATE Row, 67: PRINT MarginText$
3420 Row = Row + 1
3430 NEXT J
3440 COLOR 10, 0
3450 LOCATE 23, 1: PRINT "REVENUE REPORTED IN 1979 FORTUNE EDITION // DATA IS NOT CALENDAR-YEAR CLAIM"
3460 LOCATE 35, 1: PRINT "[W/X] MOVE  [PGUP/PGDN] PAGE  [ENTER] DETAIL  [S] SEARCH  [O] SORT  [ESC] BACK"
3470 K$ = INKEY$
3480 IF K$ = "" THEN GOTO 3470
3490 IF K$ = CHR$(0) + CHR$(72) OR UCASE$(K$) = "W" THEN DirPos = DirPos - 1: GOTO 3120
3500 IF K$ = CHR$(0) + CHR$(80) OR UCASE$(K$) = "X" THEN DirPos = DirPos + 1: GOTO 3120
3510 IF K$ = CHR$(0) + CHR$(73) OR UCASE$(K$) = "P" THEN DirPos = DirPos - 12: GOTO 3120
3520 IF K$ = CHR$(0) + CHR$(81) OR UCASE$(K$) = "N" THEN DirPos = DirPos + 12: GOTO 3120
3530 IF K$ = CHR$(13) THEN DetailIndex = DirList(DirPos): GOSUB 4000: GOTO 3120
3540 IF UCASE$(K$) = "S" AND InSearch = 1 THEN GOTO 3470
3545 IF UCASE$(K$) = "S" AND InSearch = 0 THEN GOSUB 5000: GOTO 3120
3550 IF UCASE$(K$) = "O" THEN GOSUB 6000: DirCount = RecordCount: FOR I = 1 TO RecordCount: DirList(I) = ORD(I): NEXT I: DirTitle$ = "COMPANY DIRECTORY": DirPos = 1: GOTO 3120
3560 IF K$ = CHR$(27) THEN RETURN
3570 GOTO 3470

4000 REM ===== COMPANY DETAIL =====
4010 I = DetailIndex
4020 GOSUB 9000
4030 LOCATE 4, 1: PRINT UCASE$(CN$(I))
4040 LOCATE 5, 1: PRINT "FORTUNE RANK: " + LTRIM$(STR$(RK(I))) + "     1979 FORTUNE EDITION"
4050 LOCATE 7, 1: PRINT "ARCHIVE LABEL ........ " + CN$(I)
4060 IF HN$(I) = "" THEN HistText$ = "N/A / NOT VERIFIED" ELSE HistText$ = HN$(I)
4070 LOCATE 8, 1: PRINT "1979 NAME ............ " + HistText$
4080 IF ALIAS$(I) <> "" THEN LOCATE 9, 1: PRINT "SEARCH ALIAS ......... " + ALIAS$(I)
4090 LOCATE 11, 1: PRINT "FORTUNE REVENUE ...... ";
4100 FmtVal = RV(I): GOSUB 9300: PRINT Fmt$
4110 LOCATE 12, 1: PRINT "FORTUNE PROFIT ....... ";
4120 IF HPF(I) = 1 THEN FmtVal = PF(I): GOSUB 9300: PRINT Fmt$ ELSE PRINT "N/A"
4130 LOCATE 13, 1: PRINT "PROFIT MARGIN ........ ";
4140 IF HPF(I) = 1 THEN MarginVal = PF(I) / RV(I) * 100: GOSUB 9370: PRINT Pct$ ELSE PRINT "N/A"
4150 LOCATE 16, 1: PRINT "STOCK QUOTE .......... ";
4160 IF HPX(I) = 1 THEN FmtVal = PX(I): GOSUB 9300: PRINT Fmt$ ELSE PRINT "NOT VERIFIED"
4170 LOCATE 17, 1: PRINT "QUOTE DATE ........... ";
4180 IF HPX(I) = 1 THEN PRINT PD$(I) ELSE PRINT "N/A"
4190 LOCATE 18, 1: PRINT "PRICE TYPE ........... ";
4200 IF HPX(I) = 1 THEN PRINT PK$(I) ELSE PRINT "N/A"
4210 LOCATE 22, 1: PRINT "MARKET CAP ........... ";
4220 IF HMC(I) = 1 THEN PRINT LTRIM$(STR$(MCAP(I))) + " MILLION" ELSE PRINT "NOT VERIFIED"
4230 LOCATE 23, 1: PRINT "MARKET CAP DATE ...... ";
4240 IF HMC(I) = 1 THEN PRINT MD$(I) ELSE PRINT "N/A"
4250 LOCATE 26, 1: PRINT "RELATIVE REVENUE"
4260 BarLen = INT(RV(I) / RV(1) * 42)
4270 IF BarLen < 1 THEN BarLen = 1
4280 IF BarLen > 42 THEN BarLen = 42
4290 LOCATE 27, 1: PRINT STRING$(BarLen, 35)
4300 LOCATE 29, 1: PRINT "RELATIVE PROFIT"
4310 IF HPF(I) = 0 THEN LOCATE 30, 1: PRINT "N/A": GOTO 4340
4320 IF PF(I) < 0 THEN LOCATE 30, 1: PRINT "LOSS " + STRING$(10, 45): GOTO 4340
4330 BarLen = INT(PF(I) / MaxProfit * 42)
4331 IF BarLen < 1 THEN BarLen = 1
4332 IF BarLen > 42 THEN BarLen = 42
4333 LOCATE 30, 1: PRINT STRING$(BarLen, 35)
4340 LOCATE 35, 1: PRINT "[R/ESC] RETURN   [C] COMPARE   [S] SOURCE NOTES"
4350 K$ = INKEY$
4360 IF K$ = "" THEN GOTO 4350
4370 IF UCASE$(K$) = "C" THEN CompareA = I: GOSUB 7500: GOTO 4020
4380 IF UCASE$(K$) = "S" THEN GOSUB 15000: GOTO 4020
4390 IF K$ = CHR$(27) OR UCASE$(K$) = "R" THEN RETURN
4400 GOTO 4350

5000 REM ===== SEARCH =====
5010 GOSUB 9000
5020 LOCATE 5, 1: PRINT "SEARCH FORTUNE DIRECTORY"
5030 LOCATE 7, 1: INPUT "ENTER COMPANY OR ALIAS (EMPTY = BACK): ", Query$
5040 Query$ = UCASE$(Query$)
5050 IF LEN(Query$) = 0 THEN RETURN
5060 SavedDirCount = DirCount
5070 SavedDirPos = DirPos
5080 SavedDirTitle$ = DirTitle$
5090 FOR I = 1 TO RecordCount
5100 SavedDirList(I) = DirList(I)
5110 NEXT I
5120 DirCount = 0
5130 FOR I = 1 TO RecordCount
5140 SearchName$ = UCASE$(CN$(I)) + " " + UCASE$(ALIAS$(I))
5150 IF INSTR(SearchName$, Query$) > 0 THEN DirCount = DirCount + 1: DirList(DirCount) = I
5160 NEXT I
5170 IF DirCount = 0 THEN LOCATE 10, 1: COLOR 14, 0: PRINT "NO MATCHES. PRESS ANY KEY.": COLOR 10, 0: GOSUB 9800: GOTO 5220
5180 DirTitle$ = "SEARCH RESULTS FOR: " + Query$
5190 DirPos = 1
5200 InSearch = 1
5210 GOSUB 3100
5220 InSearch = 0
5230 DirCount = SavedDirCount
5240 DirPos = SavedDirPos
5250 DirTitle$ = SavedDirTitle$
5260 FOR I = 1 TO RecordCount
5270 DirList(I) = SavedDirList(I)
5280 NEXT I
5290 RETURN

6000 REM ===== SORT MENU =====
6010 GOSUB 9000
6020 LOCATE 5, 1: PRINT "SORT / RANKINGS"
6030 LOCATE 7, 1: PRINT "[1] FORTUNE RANK ASCENDING"
6040 LOCATE 8, 1: PRINT "[2] REVENUE DESCENDING"
6050 LOCATE 9, 1: PRINT "[3] PROFIT DESCENDING"
6060 LOCATE 10, 1: PRINT "[4] PROFIT MARGIN DESCENDING"
6070 LOCATE 11, 1: PRINT "[5] COMPANY ALPHABETICAL"
6080 LOCATE 12, 1: PRINT "[6] VERIFIED STOCK PRICE DESCENDING"
6090 LOCATE 13, 1: PRINT "[7] VERIFIED MARKET CAP DESCENDING"
6100 LOCATE 16, 1: PRINT "UNAVAILABLE VALUES REMAIN LAST AND ARE NEVER TREATED AS ZERO."
6110 LOCATE 18, 1: PRINT "[ESC] BACK  SELECT: ";
6120 K$ = INKEY$
6130 IF K$ = "" THEN GOTO 6120
6140 IF K$ = CHR$(27) THEN RETURN
6150 SortMode = VAL(K$)
6160 IF SortMode < 1 OR SortMode > 7 THEN GOTO 6120
6170 GOSUB 6200
6180 RETURN

6200 REM ===== BASIC SELECTION SORT =====
6210 REM ponytail: 100-row O(n^2) sort is deliberate; replace only if the dataset grows materially.
6220 FOR I = 1 TO RecordCount - 1
6230 FOR J = I + 1 TO RecordCount
6240 A = ORD(I): B = ORD(J): SwapFlag = 0
6250 IF SortMode = 1 AND RK(A) > RK(B) THEN SwapFlag = 1
6260 IF SortMode = 2 AND RV(A) < RV(B) THEN SwapFlag = 1
6270 IF SortMode = 3 THEN IF HPF(A) = 0 AND HPF(B) = 1 THEN SwapFlag = 1 ELSE IF HPF(A) = 1 AND HPF(B) = 1 AND PF(A) < PF(B) THEN SwapFlag = 1
6280 IF SortMode = 4 THEN IF HPF(A) = 0 AND HPF(B) = 1 THEN SwapFlag = 1 ELSE IF HPF(A) = 1 AND HPF(B) = 1 AND PF(A) / RV(A) < PF(B) / RV(B) THEN SwapFlag = 1
6290 IF SortMode = 5 AND UCASE$(CN$(A)) > UCASE$(CN$(B)) THEN SwapFlag = 1
6300 IF SortMode = 6 THEN IF HPX(A) = 0 AND HPX(B) = 1 THEN SwapFlag = 1 ELSE IF HPX(A) = 1 AND HPX(B) = 1 AND PX(A) < PX(B) THEN SwapFlag = 1
6310 IF SortMode = 7 THEN IF HMC(A) = 0 AND HMC(B) = 1 THEN SwapFlag = 1 ELSE IF HMC(A) = 1 AND HMC(B) = 1 AND MCAP(A) < MCAP(B) THEN SwapFlag = 1
6320 IF SwapFlag = 1 THEN T = ORD(I): ORD(I) = ORD(J): ORD(J) = T
6330 NEXT J
6340 NEXT I
6350 RETURN

7000 REM ===== COMPARISON MODE =====
7010 GOSUB 9000
7020 LOCATE 5, 1: PRINT "COMPANY COMPARISON"
7030 LOCATE 7, 1: INPUT "FIRST FORTUNE RANK (1-100, 0 = BACK): ", CompareA
7040 IF CompareA = 0 THEN RETURN
7050 IF CompareA < 1 OR CompareA > RecordCount THEN GOTO 7010
7060 LOCATE 8, 1: INPUT "SECOND FORTUNE RANK (1-100): ", CompareB
7070 IF CompareB < 1 OR CompareB > RecordCount OR CompareB = CompareA THEN GOTO 7010
7080 GOSUB 7100
7090 RETURN

7100 REM ===== COMPARISON DISPLAY =====
7110 A = CompareA: B = CompareB
7120 GOSUB 9000
7130 LOCATE 4, 1: PRINT "SIDE-BY-SIDE CORPORATE COMPARISON"
7140 LOCATE 6, 3: PRINT UCASE$(CN$(A))
7150 LOCATE 6, 47: PRINT UCASE$(CN$(B))
7160 LOCATE 7, 1: PRINT STRING$(112, 45)
7170 LOCATE 9, 1: PRINT "RANK"
7180 LOCATE 9, 20: PRINT LTRIM$(STR$(RK(A)))
7190 LOCATE 9, 64: PRINT LTRIM$(STR$(RK(B)))
7200 LOCATE 11, 1: PRINT "REVENUE"
7210 FmtVal = RV(A): GOSUB 9300: LOCATE 11, 20: PRINT Fmt$
7220 FmtVal = RV(B): GOSUB 9300: LOCATE 11, 64: PRINT Fmt$
7230 LOCATE 13, 1: PRINT "PROFIT"
7240 IF HPF(A) = 1 THEN FmtVal = PF(A): GOSUB 9300: LOCATE 13, 20: PRINT Fmt$ ELSE LOCATE 13, 20: PRINT "N/A"
7250 IF HPF(B) = 1 THEN FmtVal = PF(B): GOSUB 9300: LOCATE 13, 64: PRINT Fmt$ ELSE LOCATE 13, 64: PRINT "N/A"
7260 LOCATE 15, 1: PRINT "MARGIN"
7270 IF HPF(A) = 1 THEN MarginVal = PF(A) / RV(A) * 100: GOSUB 9370: LOCATE 15, 20: PRINT Pct$ ELSE LOCATE 15, 20: PRINT "N/A"
7280 IF HPF(B) = 1 THEN MarginVal = PF(B) / RV(B) * 100: GOSUB 9370: LOCATE 15, 64: PRINT Pct$ ELSE LOCATE 15, 64: PRINT "N/A"
7290 LOCATE 17, 1: PRINT "PRICE"
7300 IF HPX(A) = 1 THEN FmtVal = PX(A): GOSUB 9300: LOCATE 17, 20: PRINT Fmt$ ELSE LOCATE 17, 20: PRINT "N/A"
7310 IF HPX(B) = 1 THEN FmtVal = PX(B): GOSUB 9300: LOCATE 17, 64: PRINT Fmt$ ELSE LOCATE 17, 64: PRINT "N/A"
7320 LOCATE 19, 1: PRINT "MCAP"
7330 IF HMC(A) = 1 THEN LOCATE 19, 20: PRINT LTRIM$(STR$(MCAP(A))) + "M" ELSE LOCATE 19, 20: PRINT "N/A"
7340 IF HMC(B) = 1 THEN LOCATE 19, 64: PRINT LTRIM$(STR$(MCAP(B))) + "M" ELSE LOCATE 19, 64: PRINT "N/A"
7350 LOCATE 22, 1: PRINT "REVENUE DIFFERENCE"
7360 FmtVal = RV(A) - RV(B): GOSUB 9300: LOCATE 24, 3: PRINT "A - B = " + Fmt$
7370 IF HPF(A) = 1 AND HPF(B) = 1 THEN FmtVal = PF(A) - PF(B): GOSUB 9300: LOCATE 25, 3: PRINT "PROFIT DIFFERENCE = " + Fmt$ ELSE LOCATE 25, 3: PRINT "PROFIT DIFFERENCE = N/A"
7380 IF RV(B) <> 0 THEN RatioVal = RV(A) / RV(B): GOSUB 9396: LOCATE 26, 3: PRINT "REVENUE RATIO A/B = " + Ratio$ ELSE LOCATE 26, 3: PRINT "REVENUE RATIO A/B = N/A"
7390 IF HPF(A) = 1 AND HPF(B) = 1 THEN MarginVal = PF(A) / RV(A) * 100 - PF(B) / RV(B) * 100: GOSUB 9370: LOCATE 27, 3: PRINT "MARGIN DIFFERENCE = " + Pct$ ELSE LOCATE 27, 3: PRINT "MARGIN DIFFERENCE = N/A"
7400 LOCATE 35, 1: PRINT "[ESC] RETURN"
7410 GOSUB 9800
7420 RETURN

7500 REM ===== COMPARE FROM DETAIL =====
7510 LOCATE 37, 1: COLOR 14, 0: INPUT "SECOND FORTUNE RANK (1-100, 0 = CANCEL): ", CompareB: COLOR 10, 0
7520 IF CompareB = 0 THEN RETURN
7530 IF CompareB < 1 OR CompareB > RecordCount OR CompareB = CompareA THEN RETURN
7540 GOSUB 7100
7550 RETURN

8000 REM ===== TOP 10 BOARD =====
8010 ViewMode = 1
8020 BoardPos = 1
8030 GOSUB 8100
8040 RETURN

8100 REM ===== BOARD VIEW LOOP =====
8110 IF ViewMode < 1 OR ViewMode > 5 THEN ViewMode = 1
8120 IF ViewMode = 1 THEN SortMode = 2: BoardTitle$ = "TOP 10 BY REVENUE": CoverageText$ = "100/100 RECORDS RANKED"
8130 IF ViewMode = 2 THEN SortMode = 3: BoardTitle$ = "TOP 10 BY PROFIT": CoverageText$ = "PROFIT AVAILABLE FOR " + LTRIM$(STR$(100 - 1)) + "/100 RECORDS"
8140 IF ViewMode = 3 THEN SortMode = 4: BoardTitle$ = "TOP 10 BY PROFIT MARGIN": CoverageText$ = "PROFIT/MARGIN AVAILABLE FOR " + LTRIM$(STR$(100 - 1)) + "/100 RECORDS"
8150 IF ViewMode = 4 THEN SortMode = 6: BoardTitle$ = "TOP VERIFIED STOCK QUOTES": CoverageText$ = LTRIM$(STR$(PriceCount)) + "/100 RECORDS VERIFIED"
8160 IF ViewMode = 5 THEN SortMode = 7: BoardTitle$ = "TOP VERIFIED MARKET CAPS": CoverageText$ = LTRIM$(STR$(McapCount)) + "/100 RECORDS VERIFIED"
8170 GOSUB 6200
8180 BoardCount = 0
8190 FOR J = 1 TO RecordCount
8200 I = ORD(J)
8210 IF ViewMode = 4 AND HPX(I) = 0 THEN GOTO 8240
8220 IF ViewMode = 5 AND HMC(I) = 0 THEN GOTO 8240
8230 BoardCount = BoardCount + 1: BoardList(BoardCount) = I
8240 NEXT J
8250 IF ViewMode <= 3 AND BoardCount > 10 THEN BoardCount = 10
8260 IF BoardCount > 0 AND BoardPos > BoardCount THEN BoardPos = BoardCount
8270 IF BoardPos < 1 THEN BoardPos = 1
8280 GOSUB 9000
8290 LOCATE 4, 1: PRINT BoardTitle$
8300 LOCATE 5, 1: PRINT CoverageText$
8310 LOCATE 7, 1: PRINT "RK  COMPANY                         METRIC          PROFIT       MARGIN"
8320 LOCATE 8, 1: PRINT "--- ------------------------------ ------------- ------------- --------"
8330 IF BoardCount = 0 THEN LOCATE 11, 1: COLOR 14, 0: PRINT "NO VERIFIED RECORDS FOR THIS VIEW.": COLOR 10, 0: GOTO 8560
8340 Row = 9
8350 PageEnd = BoardCount
8360 IF PageEnd > 10 THEN PageEnd = 10
8370 FOR J = 1 TO PageEnd
8380 I = BoardList(J)
8390 IF J = BoardPos THEN COLOR 14, 0 ELSE COLOR 10, 0
8400 LOCATE Row, 1: IF J = BoardPos THEN PRINT ">" ELSE PRINT " "
8410 RKText$ = RIGHT$("  " + LTRIM$(STR$(RK(I))), 2)
8420 LOCATE Row, 4: PRINT RKText$
8430 Source$ = UCASE$(CN$(I)): MaxLen = 30: GOSUB 9400: LOCATE Row, 7: PRINT Trunc$
8440 IF ViewMode = 1 THEN FmtVal = RV(I): GOSUB 9300: MetricText$ = Fmt$
8450 IF ViewMode = 2 AND HPF(I) = 1 THEN FmtVal = PF(I): GOSUB 9300: MetricText$ = Fmt$ ELSE IF ViewMode = 2 THEN MetricText$ = "N/A"
8460 IF ViewMode = 3 AND HPF(I) = 1 THEN MarginVal = PF(I) / RV(I) * 100: GOSUB 9370: MetricText$ = Pct$ ELSE IF ViewMode = 3 THEN MetricText$ = "N/A"
8470 IF ViewMode = 4 THEN FmtVal = PX(I): GOSUB 9300: MetricText$ = Fmt$
8480 IF ViewMode = 5 THEN MetricText$ = LTRIM$(STR$(MCAP(I))) + "M"
8490 LOCATE Row, 39: PRINT MetricText$
8500 IF HPF(I) = 1 THEN FmtVal = PF(I): GOSUB 9300: ProfitText$ = Fmt$ ELSE ProfitText$ = "N/A"
8510 LOCATE Row, 53: PRINT ProfitText$
8520 IF HPF(I) = 1 THEN MarginVal = PF(I) / RV(I) * 100: GOSUB 9370: MarginText$ = Pct$ ELSE MarginText$ = "N/A"
8530 LOCATE Row, 67: PRINT MarginText$
8540 Row = Row + 1
8550 NEXT J
8560 COLOR 10, 0
8570 LOCATE 35, 1: PRINT "[W/X] MOVE  [1]REV [2]PROFIT [3]MARGIN [4]PRICE [5]MCAP [N]NEXT [ESC]BACK"
8580 K$ = INKEY$
8590 IF K$ = "" THEN GOTO 8580
8600 IF K$ = CHR$(27) THEN RETURN
8610 IF K$ = CHR$(13) AND BoardCount > 0 THEN DetailIndex = BoardList(BoardPos): GOSUB 4000: GOTO 8100
8620 IF K$ = CHR$(0) + CHR$(72) OR UCASE$(K$) = "W" THEN BoardPos = BoardPos - 1: GOTO 8100
8630 IF K$ = CHR$(0) + CHR$(80) OR UCASE$(K$) = "X" THEN BoardPos = BoardPos + 1: GOTO 8100
8640 IF UCASE$(K$) = "N" THEN ViewMode = ViewMode + 1: IF ViewMode > 5 THEN ViewMode = 1: BoardPos = 1: GOTO 8100
8650 IF K$ >= "1" AND K$ <= "5" THEN ViewMode = VAL(K$): BoardPos = 1: GOTO 8100
8660 GOTO 8580

9000 REM ===== COMMON TERMINAL HEADER =====
9010 CLS
9020 COLOR 10, 0
9030 LOCATE 1, 1: PRINT STRING$(120, 61)
9040 LOCATE 2, 1: PRINT "  WALL STREET 1979  //  FORTUNE 100 CORPORATE MONITOR"
9050 LOCATE 3, 1: PRINT "  OFFLINE HISTORICAL RECONSTRUCTION  //  FORTUNE RANK = REVENUE RANK"
9060 LOCATE 38, 1: PRINT STRING$(120, 45)
9070 RETURN

9300 REM ===== MONEY FORMATTER =====
9310 Temp = ABS(FmtVal)
9320 IF Temp >= 1000 THEN Rounded = INT(Temp + .5) / 1000: Unit$ = "B" ELSE Rounded = INT(Temp * 10 + .5) / 10: Unit$ = "M"
9330 NumText$ = LTRIM$(STR$(Rounded))
9340 IF FmtVal < 0 THEN Fmt$ = "-$" + NumText$ + Unit$ ELSE Fmt$ = "$" + NumText$ + Unit$
9350 RETURN

9360 REM ===== PERCENT FORMATTER =====
9370 IF MarginVal >= 0 THEN Rounded = INT(MarginVal * 100 + .5) / 100 ELSE Rounded = -INT(ABS(MarginVal) * 100 + .5) / 100
9380 Pct$ = LTRIM$(STR$(Rounded)) + "%"
9390 RETURN

9395 REM ===== RATIO FORMATTER =====
9396 Rounded = INT(RatioVal * 100 + .5) / 100
9397 Ratio$ = LTRIM$(STR$(Rounded)) + "x"
9398 RETURN

9400 REM ===== LIST TRUNCATION =====
9410 IF LEN(Source$) <= MaxLen THEN Trunc$ = Source$ ELSE Trunc$ = LEFT$(Source$, MaxLen - 3) + "..."
9420 RETURN

9800 REM ===== WAIT FOR ANY KEY =====
9810 K$ = INKEY$
9820 IF K$ = "" THEN GOTO 9810
9830 RETURN

