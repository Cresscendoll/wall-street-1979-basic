9620 FractionPart = ScaledValue - WholePart * 1000
9630 WholeText$ = LTRIM$(STR$(WholePart))
9640 FractionText$ = LTRIM$(STR$(FractionPart))
9650 IF FractionPart < 10 THEN FractionText$ = "00" + FractionText$ ELSE IF FractionPart < 100 THEN FractionText$ = "0" + FractionText$
9660 Fixed$ = WholeText$ + "." + FractionText$
9670 RETURN

9680 REM ===== MAKE FIXED TWO DECIMALS =====
9690 WholePart = INT(ScaledValue / 100)
9700 FractionPart = ScaledValue - WholePart * 100
9710 WholeText$ = LTRIM$(STR$(WholePart))
9720 FractionText$ = LTRIM$(STR$(FractionPart))
9730 IF FractionPart < 10 THEN FractionText$ = "0" + FractionText$
9740 Fixed2$ = WholeText$ + "." + FractionText$
9750 RETURN

9800 REM ===== WAIT FOR ANY KEY =====
9810 K$ = INKEY$
9820 IF K$ = "" THEN GOTO 9810
9830 RETURN

