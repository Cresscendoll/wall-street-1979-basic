6300 IF SortMode = 6 AND UCASE$(CN$(A)) > UCASE$(CN$(B)) THEN SwapFlag = 1
6310 IF SortMode = 7 AND WEIGHT(A) < WEIGHT(B) THEN SwapFlag = 1
6320 IF SwapFlag = 1 THEN T = ORD(I): ORD(I) = ORD(J): ORD(J) = T
6330 NEXT J
6340 NEXT I
6350 RETURN

