9300 REM ===== MARKET VALUE FORMATTER =====
9310 Temp = ABS(FmtVal)
9320 IF Temp >= 1000000000 THEN ScaledValue = INT(Temp / 1000000 + .5): Unit$ = "B" ELSE IF Temp >= 1000000 THEN ScaledValue = INT(Temp / 1000 + .5): Unit$ = "M" ELSE ScaledValue = INT(Temp + .5): Unit$ = "K"
9330 IF Unit$ = "K" THEN NumText$ = LTRIM$(STR$(ScaledValue)) ELSE GOSUB 9600: NumText$ = Fixed$
9340 IF FmtVal < 0 THEN Fmt$ = "-$" + NumText$ + Unit$ ELSE Fmt$ = "$" + NumText$ + Unit$
9355 RETURN

9360 REM ===== SHARES FORMATTER =====
9370 Temp = ABS(FmtVal)
9380 IF Temp >= 1000000 THEN ScaledValue = INT(Temp / 1000 + .5): Unit$ = "M" ELSE ScaledValue = INT(Temp + .5): Unit$ = "K"
9385 IF Unit$ = "K" THEN NumText$ = LTRIM$(STR$(ScaledValue)) ELSE GOSUB 9600: NumText$ = Fixed$
9386 IF FmtVal < 0 THEN Fmt$ = "-" + NumText$ + Unit$ ELSE Fmt$ = NumText$ + Unit$
9388 RETURN

9390 REM ===== PRICE FORMATTER =====
9391 ScaledValue = INT(ABS(FmtVal) * 100 + .5)
9392 GOSUB 9680
9393 IF FmtVal < 0 THEN Fmt$ = "-$" + Fixed2$ ELSE Fmt$ = "$" + Fixed2$
9395 RETURN

9410 REM ===== PERCENT FORMATTER =====
9420 ScaledValue = INT(ABS(FmtVal) * 1000 + .5)
9421 GOSUB 9600
9422 IF FmtVal < 0 THEN Pct$ = "-" + Fixed$ + "%" ELSE Pct$ = Fixed$ + "%"
